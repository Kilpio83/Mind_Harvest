; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mind harvest"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
GameState="*res://scripts/autoload/game_state.gd"
PatientManager="*res://scripts/autoload/patient_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"

[dialogic]

directories/dch_directory={
"unit_test_character": "res://Tests/Resources/unit_test_character.dch"
}
directories/dtl_directory={
"analyze_session": "res://dialogic/timelines/morning/analyze_session.dtl",
"between_patients": "res://dialogic/timelines/system/between_patients.dtl",
"chat_bea": "res://dialogic/timelines/morning/chat_bea.dtl",
"day_intro": "res://dialogic/timelines/system/day_intro.dtl",
"end_of_day": "res://dialogic/timelines/system/end_of_day.dtl",
"intro": "res://dialogic/timelines/system/intro.dtl",
"jogging": "res://dialogic/timelines/morning/jogging.dtl",
"marisol/session_1": "res://dialogic/timelines/patients/marisol/session_1.dtl",
"marisol/session_2": "res://dialogic/timelines/patients/marisol/session_2.dtl",
"marisol/session_3": "res://dialogic/timelines/patients/marisol/session_3.dtl",
"morning_menu": "res://dialogic/timelines/system/morning_menu.dtl",
"read_book": "res://dialogic/timelines/morning/read_book.dtl",
"review_files": "res://dialogic/timelines/morning/review_files.dtl",
"session_1": "res://dialogic/timelines/patients/anna/session_1.dtl",
"session_2": "res://dialogic/timelines/patients/anna/session_2.dtl",
"session_3": "res://dialogic/timelines/patients/anna/session_3.dtl",
"walk": "res://dialogic/timelines/morning/walk.dtl"
}
layout/style_directory={}
extensions_folder="res://addons/dialogic_additions/"
variables={
"check_result": false,
"flags": {
"analyzed_anna": false,
"analyzed_marisol": false,
"did_analyze_session": false,
"did_chat_bea": false,
"did_jogging": false,
"did_read_book": false,
"did_review_files": false,
"did_walk": false,
"intro_done": false,
"last_photo_success": false,
"met_anna": false,
"met_marisol": false
},
"game": {
"current_patient": "",
"day": 1,
"has_patients": false,
"last_random_stat": "",
"morning_slots_left": 2,
"phase": "morning"
},
"patients": {
"anna": {
"ending": "",
"last_day": -1,
"next_day": 0,
"progress": 0,
"trust": 30
},
"marisol": {
"ending": "",
"last_day": -1,
"next_day": 0,
"progress": 0,
"trust": 30
}
},
"photos": {
"count": 0
},
"stats": {
"intelligence": 1,
"intelligence_xp": 0,
"knowledge": 1,
"knowledge_xp": 0,
"patience": 1,
"patience_xp": 0,
"perception": 1,
"perception_xp": 0
}
}
glossary/default_case_sensitive=true
layout/style_list=[]
layout/default_style="Default"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/gdUnit4/plugin.cfg")

[input]

dialogic_default_action={
"deadzone": 0.5,
