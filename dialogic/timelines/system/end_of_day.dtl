set {game.phase} = "evening"
narrator: "You lock up the office."
if {patients.anna.progress} > 0 and {patients.anna.ending} == "":
	narrator: "Anna — therapy {patients.anna.therapy_progress}/100, bond {patients.anna.personal_bond}."
if {patients.marisol.progress} > 0 and {patients.marisol.ending} == "":
	narrator: "Marisol — therapy {patients.marisol.therapy_progress}/100, bond {patients.marisol.personal_bond}."
if {patients.anna.ending} != "" or {patients.marisol.ending} != "":
	narrator: "Some cases have reached their conclusion."
if {photos.count} > 0:
	narrator: "The album grows. {photos.count} photo(s) so far."
narrator: "Day {game.day} is done."
[end_day]
